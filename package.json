{
  "name": "checkbox-reminder",
  "version": "1.0.3",
  "description": "Obsidian plugin: set reminders on checkboxes, get desktop notifications and see them in a list.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.config.mjs test",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "obsidian": "1.14.4",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.0"
  }
}
